pub fn criba(n: usize) -> Vec<bool> {
    let mut primo = vec![true; n + 1];

    primo[0] = false;

    if n >= 1 {
        primo[1] = false;
    }

    let mut p = 2;

    while p <= n / p {
        if primo[p] {
            let mut multiplo = p * p;

            while multiplo <= n {
                primo[multiplo] = false;
                multiplo += p;
            }
        }

        p += 1;
    }

    primo
}
